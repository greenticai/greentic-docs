---
// Inlines a diagram from src/assets/diagrams so it follows the Starlight theme
// (light and dark) through CSS variables, which an <img> could not do.
interface Props {
	name: string;
}
const { name } = Astro.props;
const files = import.meta.glob('../assets/diagrams/*.svg', {
	query: '?raw',
	import: 'default',
	eager: true,
}) as Record<string, string>;
const svg = files[`../assets/diagrams/${name}.svg`];
if (!svg) {
	throw new Error(`Unknown diagram "${name}"`);
}
---

<Fragment set:html={svg} />
